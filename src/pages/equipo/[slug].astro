---
import Minibar from '@/components/portfolio/Minibar.vue';
import Inicio from '@/components/portfolio/Inicio.astro';
import Perfil from '@/components/portfolio/Perfil.astro';
import Conocimientos from '@/components/portfolio/Conocimientos.vue';
import Experiencia from '@/components/portfolio/Experiencia.vue';
import Servicios from '@/components/portfolio/Servicios.vue';
import Portfolio from '@/components/portfolio/Portfolio.vue';
import Contacto from '@/components/portfolio/Contacto.vue';
import Footer from '@/components/portfolio/Footer.astro';
import Actualizando from '@/components/portfolio/Actualizando.astro';
import GoTop from '@/components/portfolio/GoTop.vue';
import CmsAviso from '@/components/portfolio/CmsAviso.astro';
import type { GetStaticPaths } from 'astro';
import Layout from '@/layouts/Portfolio.astro';
import { cmsUrl, leerEquipo, leerServicios, leerTrabajos } from '@/lib/cms';
import type { MiembroVista } from '@/lib/cms-mapa';

export const getStaticPaths = (async () => {
  const equipo = await leerEquipo();
  if (!equipo.ok) return [];

  return equipo.miembros.map((miembro) => ({
    params: { slug: miembro.slug },
    props: { miembro },
  }));
}) satisfies GetStaticPaths;

interface Props {
  miembro: MiembroVista;
}

const { slug } = Astro.params;
const { miembro } = Astro.props as Props;
const trabajos = await leerTrabajos(miembro.id);
const servicios = await leerServicios(miembro.id);
const urlCms = cmsUrl();
const tieneConocimientos = miembro.conocimientos.some((grupo) => grupo.length > 0);
---

<Layout
  nombre={miembro.nombre}
  titulo={miembro.titulo}
  slug={slug}
  color={miembro.color}
>
  {miembro.activo && (
    <Minibar client:only whatsapp={miembro.whatsapp} />
  )}
  <div class="vg-main-wrapper">
    {miembro.activo && (
      <>
        <Inicio nombre={miembro.nombre} titulo={miembro.titulo} />
        <div class="vg-page page-about" id="perfil">
          <Perfil
            whatsapp={miembro.whatsapp}
            imagen={miembro.imagen}
            nombre={miembro.nombre}
            titulo={miembro.titulo}
            presentacion={miembro.presentacion}
            direccion={miembro.direccion}
            nacimiento={miembro.nacimiento}
            mail={miembro.mail}
          />
          {tieneConocimientos && (
            <Conocimientos
              conocimientos={miembro.conocimientos}
              conocimientos_p={miembro.conocimientos_p}
            />
          )}
          {(miembro.educacion_t.length > 0 || miembro.experiencia_t.length > 0) && (
            <Experiencia
              educacion_a={miembro.educacion_a}
              educacion_i={miembro.educacion_i}
              educacion_t={miembro.educacion_t}
              educacion_d={miembro.educacion_d}
              experiencia_a={miembro.experiencia_a}
              experiencia_t={miembro.experiencia_t}
              experiencia_s={miembro.experiencia_s}
              experiencia_d={miembro.experiencia_d}
            />
          )}
        </div>
        {servicios.ok && servicios.items.length > 0 && (
          <Servicios
            colorDark={miembro.colorDark}
            colorDarken={miembro.colorDarken}
            servicios={servicios.items}
          />
        )}
        {!servicios.ok && (
          <CmsAviso
            titulo="No se pudieron leer los servicios"
            detalle={`El CMS en ${urlCms} no respondió al pedir los servicios de este perfil. ${servicios.error}`}
          />
        )}
        {trabajos.ok ? (
          <Portfolio
            categorias={trabajos.categorias}
            portfolio={trabajos.items}
            client:only
          />
        ) : (
          <CmsAviso
            titulo="No se pudieron leer los trabajos"
            detalle={`El CMS en ${urlCms} no respondió al pedir los trabajos de este perfil. ${trabajos.error}`}
          />
        )}
        <Contacto client:only="vue" colorDarken={miembro.colorDarken} myEmail={miembro.mail} />
      </>
    )}
    {!miembro.activo && <Actualizando />}
    <Footer colorDark={miembro.colorDark} />
    <GoTop client:only="vue" />
  </div>
</Layout>
